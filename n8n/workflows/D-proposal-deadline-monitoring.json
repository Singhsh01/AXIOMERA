        "url": "={{ $env.AXIOMERA_API_URL }}/api/v1/notifications",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Axiomera-Service-Token",
              "value": "={{ $env.AXIOMERA_SERVICE_TOKEN }}"
            },
            {
              "name": "X-N8N-Execution-Id",
              "value": "={{ $execution.id }}"
            },
            {
              "name": "X-Axiomera-Workflow",
              "value": "D"
