        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: `RFP due in ${$json.hours_left}h: ${$json.title}`, body: `${$json.open_mandatory} mandatory requirement(s) not yet evidenced \u00b7 status ${$json.status}`, severity: $json.severity, link: `/app/rfps/${$json.rfp_id}` }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "id": "0f46e7c6-deac-5a62-b32b-865e12a05790",
      "position": [
        1100,
