        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ reason: `Due in ${$json.hours_left}h with ${$json.open_mandatory} open mandatory requirement(s)` }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "id": "0e0de48f-287c-5db3-9ad5-64501d84fd23",
