# Copy to .env. Everything has a working local default; change secrets before exposing anything.

# --- secrets shared between the API and n8n
ORKESTR_JWT_SECRET=change-me-to-a-long-random-string
ORKESTR_SERVICE_TOKEN=dev-service-token
ORKESTR_WEBHOOK_SECRET=dev-webhook-secret
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
POSTGRES_PASSWORD=orkestr

# --- model providers (optional). Without a key, agents use deterministic fixtures and say so.
ORKESTR_LLM_PROVIDER=fixture          # fixture | anthropic | openai
ORKESTR_ANTHROPIC_API_KEY=
ORKESTR_ANTHROPIC_MODEL=claude-sonnet-4-5
ORKESTR_OPENAI_API_KEY=
ORKESTR_OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter …)
ORKESTR_OPENAI_MODEL=gpt-4o-mini
ORKESTR_EMBEDDING_PROVIDER=hashing    # hashing (offline) | openai

# --- live integrations (optional). Without these, connectors use labelled local simulators.
ORKESTR_SLACK_WEBHOOK_URL=
ORKESTR_JIRA_BASE_URL=
ORKESTR_JIRA_EMAIL=
ORKESTR_JIRA_API_TOKEN=
ORKESTR_JIRA_PROJECT_KEY=
ORKESTR_HUBSPOT_TOKEN=

# --- tracing (set when running with --profile observability)
# ORKESTR_OTEL_ENABLED=true
# ORKESTR_OTEL_ENDPOINT=http://otel-collector:4318

# --- n8n image (tested with n8n 1.123; override if this tag is unavailable)
# N8N_IMAGE=n8nio/n8n:1.123.92
