# Copy to .env. Everything has a working local default; change secrets before exposing anything.
# Settings are named AXIOMERA_*. The pre-rename ORKESTR_* names are still read (with a warning).

# --- upgrading an installation created before the rename (as "Orkestr")? Keep your data by pinning
#     the old Docker project, database user and database name; see docs/naming-audit.md.
# COMPOSE_PROJECT_NAME=orkestr
# POSTGRES_USER=orkestr
# POSTGRES_DB=orkestr

# --- secrets shared between the API and n8n
AXIOMERA_JWT_SECRET=change-me-to-a-long-random-string
AXIOMERA_SERVICE_TOKEN=dev-service-token
AXIOMERA_WEBHOOK_SECRET=dev-webhook-secret
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
POSTGRES_PASSWORD=axiomera

# --- model providers (optional). Without a key, agents use deterministic fixtures and say so.
AXIOMERA_LLM_PROVIDER=fixture          # fixture | anthropic | openai
AXIOMERA_ANTHROPIC_API_KEY=
AXIOMERA_ANTHROPIC_MODEL=claude-sonnet-4-5
AXIOMERA_OPENAI_API_KEY=
AXIOMERA_OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter …)
AXIOMERA_OPENAI_MODEL=gpt-4o-mini
AXIOMERA_EMBEDDING_PROVIDER=hashing    # hashing (offline) | openai

# --- live integrations (optional). Without these, connectors use labelled local simulators.
AXIOMERA_SLACK_WEBHOOK_URL=
AXIOMERA_JIRA_BASE_URL=
AXIOMERA_JIRA_EMAIL=
AXIOMERA_JIRA_API_TOKEN=
AXIOMERA_JIRA_PROJECT_KEY=
AXIOMERA_HUBSPOT_TOKEN=

# --- tracing (set when running with --profile observability)
# AXIOMERA_OTEL_ENABLED=true
# AXIOMERA_OTEL_ENDPOINT=http://otel-collector:4318

# --- n8n image (tested with n8n 1.123; override if this tag is unavailable)
# N8N_IMAGE=n8nio/n8n:1.123.92

# --- Scaling (see docs/scalability.md)
# WEB_CONCURRENCY=2              # API worker processes; about one per CPU core
# AXIOMERA_DB_POOL_SIZE=10        # per worker; keep workers x (pool + 10 overflow) below Postgres max_connections (120)
# AXIOMERA_RATE_LIMIT_PER_MINUTE=600
